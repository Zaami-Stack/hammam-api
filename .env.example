# ==========================================================================
# Moroccan Hammam Management System - Backend environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

NODE_ENV=development
PORT=5000

# --- TiDB Cloud connection ------------------------------------------------
# Prefer a single connection string (TiDB Cloud provides one in the cluster
# "Connect" dialog). Alternatively use the individual DATABASE_* variables.
DATABASE_URL=mysql://user:password@host:4000/hammam?ssl-mode=REQUIRED
# DATABASE_HOST=
# DATABASE_PORT=4000
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_NAME=hammam

# SSL: true | false | verify-identity
# TiDB Cloud requires SSL. Use "verify-identity" in production.
DATABASE_SSL=true
# Optional CA bundle path for full verification (TiDB Cloud offers a CA cert).
# DATABASE_SSL_CA=./certs/ca.pem

# --- Authentication -------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed origins.
# Dev: http://localhost:5173   Prod: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# --- Cookies --------------------------------------------------------------
# true in production (HTTPS). Cookie is always httpOnly.
COOKIE_SECURE=false

# Set true when the backend runs behind a reverse proxy (Vercel/Render/etc).
TRUST_PROXY=false

# --- Testing --------------------------------------------------------------
# Dedicated database used by the test suite (wiped before each suite).
TEST_DATABASE_URL=
